                "VV10": {"ALIASES": ["NL"], "DESCRIPTION": "Corrélation non locale de Vydrov et Van Voorhis."},
                "LENNARD_JONES": {"ALIASES": ["LJ"], "DESCRIPTION": "Potentiel de paire de Lennard-Jones (paramètres UFF ou explicites)."},
                "SLATER_KIRKWOOD": {"DESCRIPTION": "Modèle atomique polarisable de Slater-Kirkwood."}
            }
        },

        "SOLVATION": {
            "DESCRIPTION": "Solvatation implicite.",
