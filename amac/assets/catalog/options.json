        "SPIN_ORBIT_COUPLING": {"ALIASES": ["SOC"], "DESCRIPTION": "Couplage spin-orbite."},
        "ELECTRIC_FIELD": {"ALIASES": ["EFIELD"], "DESCRIPTION": "Champ électrique externe uniforme."},
        "POINT_CHARGES": {"ALIASES": ["EXTERNAL_CHARGES"], "DESCRIPTION": "Charges ponctuelles externes (plongement électrostatique QM/MM)."}
